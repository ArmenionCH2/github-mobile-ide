{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Mobile IDE",
  "version": "0.2.0",
  "identifier": "com.armenion.githubmobileide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub Mobile IDE",
        "width": 1100,
        "height": 720,
        "minWidth": 350,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
