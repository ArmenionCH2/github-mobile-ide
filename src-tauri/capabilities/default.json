{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "main-capability",
  "description": "GitHub REST access and external URL opening",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.github.com/*"
        }
      ]
    }
  ]
}
